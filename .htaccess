# Apache .htaccess configuration for Hostinger / cPanel / Shared Hosting
# Enables clean URLs, correct MIME types, and prevents 403 Forbidden directory listing issues

# Disable directory browsing (prevents 403 when no index file matches)
Options -Indexes

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Clean URL rewrites (e.g., /bounce-houses -> /bounce-houses.html)
  RewriteRule ^bounce-houses/?$ bounce-houses.html [L]
  RewriteRule ^movie-screen/?$ movie-screen.html [L]
  RewriteRule ^popcorn-cart/?$ popcorn-cart.html [L]
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^contact/?$ contact.html [L]

  # 3. Fallback to index.html for root or unmatched routes
  RewriteRule ^$ index.html [L]
  RewriteRule ^index/?$ index.html [L]
</IfModule>

# Set correct character encoding and MIME types
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
